[Unit]
Description=PostVenta Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/postventa/backend
ExecStart=/opt/postventa/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
EnvironmentFile=/opt/postventa/backend/.env

[Install]
WantedBy=multi-user.target
